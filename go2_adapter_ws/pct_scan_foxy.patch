diff --git a/src/planner/plan_manage/include/plan_manage/tracking_checks.h b/src/planner/plan_manage/include/plan_manage/tracking_checks.h
new file mode 100644
index 0000000..2e87a39
--- /dev/null
+++ b/src/planner/plan_manage/include/plan_manage/tracking_checks.h
@@ -0,0 +1,42 @@
+#ifndef PLAN_MANAGE_TRACKING_CHECKS_H
+#define PLAN_MANAGE_TRACKING_CHECKS_H
+
+#include <cmath>
+#include <cstddef>
+#include <vector>
+
+namespace scan_planner
+{
+inline bool validCubicKnots(std::size_t points, int order,
+                            const std::vector<double> &knots)
+{
+  if (order != 3 || points < 4 || knots.size() != points + 4)
+    return false;
+  for (std::size_t i = 0; i < knots.size(); ++i)
+    if (!std::isfinite(knots[i]) || (i && knots[i] < knots[i - 1]))
+      return false;
+  if (!(knots[points] > knots[3]) || !std::isfinite(knots[points] - knots[3]))
+    return false;
+  // UniformBspline differentiates twice. Reject zero denominators in either
+  // derivative before the spline can reach Eigen / the command callback.
+  for (std::size_t i = 0; i + 1 < points; ++i)
+    if (!(knots[i + 4] > knots[i + 1]))
+      return false;
+  for (std::size_t i = 0; i + 2 < points; ++i)
+    if (!(knots[i + 4] > knots[i + 2]))
+      return false;
+  return true;
+}
+
+inline bool trackingTimesValid(double now, double odom_at, double trajectory_at,
+                              double duration, double odom_timeout, double grace)
+{
+  return std::isfinite(now) && std::isfinite(odom_at) &&
+         std::isfinite(trajectory_at) && std::isfinite(duration) && duration > 0.0 &&
+         std::isfinite(odom_timeout) && odom_timeout > 0.0 &&
+         std::isfinite(grace) && grace >= 0.0 &&
+         now >= odom_at && now - odom_at <= odom_timeout &&
+         now >= trajectory_at && now - trajectory_at <= duration + grace;
+}
+}  // namespace scan_planner
+#endif
diff --git a/src/planner/plan_manage/test/test_tracking_checks.cpp b/src/planner/plan_manage/test/test_tracking_checks.cpp
new file mode 100644
index 0000000..e716b5e
--- /dev/null
+++ b/src/planner/plan_manage/test/test_tracking_checks.cpp
@@ -0,0 +1,33 @@
+#include <cassert>
+#include <limits>
+#include <vector>
+
+#include "plan_manage/tracking_checks.h"
+
+int main()
+{
+  using scan_planner::validCubicKnots;
+  using scan_planner::trackingTimesValid;
+  const std::vector<double> uniform{-3, -2, -1, 0, 1, 2, 3, 4, 5, 6};
+  assert(validCubicKnots(6, 3, uniform));
+  assert(validCubicKnots(4, 3, {0, 0, 0, 0, 1, 1, 1, 1}));
+  assert(!validCubicKnots(6, 2, uniform));
+  assert(!validCubicKnots(6, 3, {0, 1}));
+  assert(!validCubicKnots(3, 3, {0, 1, 2, 3, 4, 5, 6}));
+  auto broken = uniform;
+  broken[4] = std::numeric_limits<double>::quiet_NaN();
+  assert(!validCubicKnots(6, 3, broken));
+  broken = uniform;
+  broken[4] = -10;
+  assert(!validCubicKnots(6, 3, broken));
+  assert(!validCubicKnots(6, 3, std::vector<double>(10, 0.0)));
+  assert(!validCubicKnots(6, 3, {0, 0, 0, 0, 0, 1, 2, 3, 4, 5}));
+  assert(trackingTimesValid(10.1, 10.0, 9.0, 2.0, 0.25, 0.25));
+  assert(!trackingTimesValid(10.3, 10.0, 9.0, 2.0, 0.25, 0.25));
+  assert(!trackingTimesValid(12.0, 12.0, 9.0, 2.0, 0.25, 0.25));
+  assert(!trackingTimesValid(8.0, 10.0, 9.0, 2.0, 0.25, 0.25));
+  assert(!trackingTimesValid(10.1, 10.0, 9.0, 0.0, 0.25, 0.25));
+  assert(!trackingTimesValid(10.1, 10.0, 9.0,
+                           std::numeric_limits<double>::infinity(), 0.25, 0.25));
+  return 0;
+}
